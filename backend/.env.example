# Copy this to .env and fill in real values
# The real .env lives on the VPS at /etc/gastosin/.env — never in the repo

ENV=development

# CORS — JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL — asyncpg DSN format
DATABASE_URL=postgresql://user:password@host.docker.internal:5432/gastosin

# Azure Document Intelligence (OCR fallback)
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Azure OpenAI — merchant categorization
# Provider: openai | azure_openai
LLM_PROVIDER=azure_openai
LLM_API_KEY=
# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
LLM_AZURE_ENDPOINT=https://your-resource.openai.azure.com/
LLM_AZURE_DEPLOYMENT=gpt-5-mini
LLM_AZURE_API_VERSION=2024-12-01-preview
# Standard OpenAI (used when LLM_PROVIDER=openai)
LLM_MODEL=gpt-5-mini
# Categorization thresholds (defaults shown)
LLM_CONFIDENCE_THRESHOLD=0.75
LLM_FUZZY_THRESHOLD=0.45

# Embeddings (future use)
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Azure AI Search (future use)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX=transactions
